{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lang-study-data"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "meta": {
      "type": "object",
      "properties": {
        "exportedAt": {
          "type": "string",
          "minLength": 1
        },
        "appVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "exportedAt",
        "appVersion"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "uiLanguage": {
          "type": "string",
          "enum": [
            "ja",
            "en"
          ]
        },
        "nativeLanguage": {
          "type": "string",
          "minLength": 1
        },
        "targetLanguage": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "object",
          "properties": {
            "purposeTags": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "purposeText": {
              "default": "",
              "type": "string"
            },
            "targetLevel": {
              "type": "string",
              "enum": [
                "A1",
                "A2",
                "B1",
                "B2",
                "C1",
                "C2"
              ]
            },
            "deadline": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dailyMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "studyDaysPerWeek": {
              "default": 6,
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "targetLevel",
            "deadline",
            "dailyMinutes"
          ]
        }
      },
      "required": [
        "uiLanguage",
        "nativeLanguage",
        "targetLanguage",
        "goal"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "canDo": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "default": "",
                "type": "string"
              },
              "keywords": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "itemEstimate": {
                "default": 20,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "optional": {
                "default": false,
                "type": "boolean"
              },
              "plannedStart": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "plannedEnd": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "status": {
                "default": "planned",
                "type": "string",
                "enum": [
                  "planned",
                  "ready",
                  "inProgress",
                  "done"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "canDo"
            ]
          }
        }
      },
      "required": [
        "units"
      ]
    },
    "content": {
      "default": {
        "units": {}
      },
      "type": "object",
      "properties": {
        "units": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "verified": {
                "default": false,
                "type": "boolean"
              },
              "generatedBy": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "tool",
                  "at"
                ]
              },
              "words": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lemma": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pos": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reading": {
                      "default": "",
                      "type": "string"
                    },
                    "meaning": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "tags": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rel": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "synonym",
                              "antonym",
                              "confusable",
                              "related"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "id"
                        ]
                      }
                    },
                    "uncertain": {
                      "default": false,
                      "type": "boolean"
                    },
                    "note": {
                      "default": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "lemma",
                    "pos",
                    "meaning"
                  ]
                }
              },
              "phrases": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "meaning": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slots": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "tag": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "tag"
                        ]
                      }
                    },
                    "fixed": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "target",
                    "meaning"
                  ]
                }
              },
              "sentences": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "meaning": {
                      "type": "string",
                      "minLength": 1
                    },
                    "wordIds": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "id",
                    "target",
                    "meaning"
                  ]
                }
              },
              "grammarNotes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "appliesTo": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "appliesTo",
                    "title",
                    "hint"
                  ]
                }
              }
            },
            "required": [
              "generatedBy"
            ]
          }
        }
      },
      "required": [
        "units"
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "fsrs": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "due": {
                "type": "string",
                "minLength": 1
              },
              "stability": {
                "type": "number",
                "minimum": 0
              },
              "difficulty": {
                "type": "number",
                "minimum": 0
              },
              "elapsedDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "scheduledDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lapses": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "lastReview": {
                "type": "string",
                "minLength": 1
              },
              "learningSteps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "due",
              "stability",
              "difficulty",
              "elapsedDays",
              "scheduledDays",
              "reps",
              "lapses",
              "state"
            ]
          }
        },
        "unitProgress": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "introducedItemIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "completedStepIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "wrongItemIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "startedAt": {
                "type": "string",
                "minLength": 1
              },
              "completedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "xp": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "streak": {
          "default": {
            "days": 0,
            "lastStudyDate": null
          },
          "type": "object",
          "properties": {
            "days": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lastStudyDate": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "sessions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "lesson",
                  "review"
                ]
              },
              "unitId": {
                "type": "string",
                "minLength": 1
              },
              "stepId": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "startedAt": {
                "type": "string",
                "minLength": 1
              },
              "endedAt": {
                "type": "string",
                "minLength": 1
              },
              "answered": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "correct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "xpGained": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "kind",
              "seed",
              "startedAt",
              "answered",
              "correct",
              "xpGained"
            ]
          }
        }
      }
    }
  },
  "required": [
    "format",
    "version",
    "meta",
    "profile",
    "plan",
    "progress"
  ],
  "title": "StudyData"
}
