{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lang-study-unit"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "unitId": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lemma": {
            "type": "string",
            "minLength": 1
          },
          "pos": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "default": "",
            "type": "string"
          },
          "meaning": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rel": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "synonym",
                    "antonym",
                    "confusable",
                    "related"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "id"
              ]
            }
          },
          "uncertain": {
            "default": false,
            "type": "boolean"
          },
          "note": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "lemma",
          "pos",
          "meaning"
        ]
      }
    },
    "phrases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "slots": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tag"
              ]
            }
          },
          "fixed": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "target",
          "meaning"
        ]
      }
    },
    "sentences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "wordIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "target",
          "meaning"
        ]
      }
    },
    "grammarNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "appliesTo",
          "title",
          "hint"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "unitId"
  ],
  "title": "UnitEnvelope"
}
