{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lang-study-skeleton"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "canDo": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "default": "",
            "type": "string"
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "itemEstimate": {
            "default": 20,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "optional": {
            "default": false,
            "type": "boolean"
          },
          "plannedStart": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "plannedEnd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "default": "planned",
            "type": "string",
            "enum": [
              "planned",
              "ready",
              "inProgress",
              "done"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "canDo"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "units"
  ],
  "title": "SkeletonEnvelope"
}
